# DRUVO UK Website — environment configuration
# Copy to .env and fill in when enabling live integrations.

SITE_NAME=DRUVO UK
# Local: http://127.0.0.1:8080
# Render production: https://druvo.uk (legacy: https://druvo-uk-website.onrender.com)
SITE_URL=http://127.0.0.1:8080
CONTACT_EMAIL=druvo.uk@gmail.com

# Catalog source: mock | druvo_api
CATALOG_SOURCE=mock

# DRUVO AI Enterprise API bridge (when CATALOG_SOURCE=druvo_api)
DRUVO_API_BASE_URL=http://127.0.0.1:8790
DRUVO_API_KEY=
DRUVO_API_TIMEOUT_SECONDS=30

# Session secret for account/checkout scaffolding (generate a long random string)
SESSION_SECRET=

# Stripe TEST MODE only — never use live keys until launch sign-off
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From Stripe Dashboard → Developers → Webhooks (test mode endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# Writable checkout session store on Render (ephemeral disk)
# CHECKOUT_DB_PATH=/tmp/druvo_checkout.db

# Shipping (UK)
SHIPPING_STANDARD_GBP=3.99
SHIPPING_FREE_THRESHOLD_GBP=75

# Customer email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Admin launch checklist (/admin/launch-checklist?token=...)
ADMIN_CHECKLIST_TOKEN=

# Keep false until launch sign-off; readiness checks enforce test Stripe keys
PRODUCTION_MODE=false
STRIPE_LIVE_MODE_CONFIRM=false
